<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.restaurantcustomerservice.controller.StaffDashboardController">
    <children>
        <Label text="Staff Dashboard" layoutX="20" layoutY="20" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <!-- Table of Customers -->
        <TableView fx:id="userTable" layoutX="20" layoutY="60" prefWidth="500" prefHeight="300">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                <TableColumn fx:id="colUsername" text="Username" prefWidth="200" />
                <TableColumn fx:id="colDate" text="Registered Date" prefWidth="250" />
                <TableColumn fx:id="colPassword" text="Password" prefWidth="200"/>
                <TableColumn fx:id="colQuestion" text="Question" prefWidth="150" />
                <TableColumn fx:id="colAnswer" text="Answer" prefWidth="150" />


            </columns>
        </TableView>

        <!-- Search Bar -->
        <Label text="Search Customer:" layoutX="550" layoutY="60" />
        <TextField fx:id="searchField" layoutX="660" layoutY="55" prefWidth="200" onKeyReleased="#handleSearch" />

        <!-- Profile Info -->
        <Label text="Logged in as: Staff" layoutX="550" layoutY="110" />
        <Label fx:id="loginTimeLabel" layoutX="550" layoutY="140" />

        <!-- Instructions -->
        <Label text="Instructions:" layoutX="550" layoutY="200" style="-fx-font-weight: bold;" />
        <TextArea editable="false" wrapText="true" layoutX="550" layoutY="225" prefWidth="310" prefHeight="135"
                  text="Welcome! As a staff member, you can view all registered customers. For reservation and order handling, please refer to the reservation module." />

        <!-- Logout -->
        <Button text="Logout" layoutX="550" layoutY="370" onAction="#handleLogout" />
    </children>
</AnchorPane>
