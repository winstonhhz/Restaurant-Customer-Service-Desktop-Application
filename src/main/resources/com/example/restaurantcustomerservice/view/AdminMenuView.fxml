<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.restaurantcustomerservice.controller.AdminMenuViewController">
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #ffffff;">
            <VBox fx:id="menuContainer" spacing="20.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <Button text="Back" onAction="#handleBack"/>
        </HBox>
    </bottom>
</BorderPane>

