<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.restaurantcustomerservice.controller.CustomerPanelController" prefWidth="700" prefHeight="600">
    <children>
        <VBox spacing="10" layoutX="30" layoutY="20" prefWidth="640" AnchorPane.leftAnchor="30" AnchorPane.topAnchor="20">
            <children>
                <Label text="Customer Reservation Panel" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100"/>
                        <ColumnConstraints minWidth="300"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                    </rowConstraints>

                    <children>
                        <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                        <Label text="Date (YYYY-MM-DD):" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                        <TextField fx:id="dateField" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                        <Label text="Time (e.g. 18:00):" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                        <TextField fx:id="timeField" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                        <Label text="Number of People:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                        <TextField fx:id="peopleField" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                        <Label text="Requirement:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                        <TextField fx:id="requirementField" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                    </children>
                </GridPane>

                <HBox spacing="15">
                    <children>
                        <Button text="Submit" onAction="#handleSubmit" />
                        <Button text="Back" onAction="#goBack" />
                    </children>
                </HBox>

                <Label text="Reservation Result:" style="-fx-font-weight: bold;" />
                <TextArea fx:id="resultArea" editable="false" prefHeight="200" wrapText="true"/>
            </children>
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>
