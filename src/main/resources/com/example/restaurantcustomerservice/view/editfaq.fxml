<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurantcustomerservice.controller.EditFAQController">
   <children>
      <VBox alignment="CENTER" layoutX="37.0" layoutY="41.0" prefHeight="416.0" prefWidth="525.0" spacing="10.0">
         <children>
            <HBox prefHeight="35.0" prefWidth="466.0" spacing="30.0">
               <children>
                  <Label text="Question:" />
                  <TextArea fx:id="questionField" prefHeight="39.0" prefRowCount="3" prefWidth="295.0" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox prefHeight="35.0" prefWidth="466.0" spacing="40.0">
               <children>
                  <Label text="Answer:" />
                  <TextArea fx:id="answerArea" prefHeight="39.0" prefRowCount="3" prefWidth="295.0" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Button fx:id="viewButton" mnemonicParsing="false" onAction="#viewFAQ" text="View" />
                  <Button fx:id="addButton" mnemonicParsing="false" onAction="#addFAQ" text="Create" />
                  <Button fx:id="editButton" mnemonicParsing="false" onAction="#editFAQ" text="Edit" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteFAQ" text="Delete" />
               </children>
            </HBox>
            <TableView fx:id="faqTable" prefHeight="300.0" prefWidth="200.0">
               <columns>
                  <TableColumn fx:id="questionCol" prefWidth="255.20000684261322" text="Question" />
                  <TableColumn fx:id="answerCol" prefWidth="255.0" text="Answer" />
               </columns>
            </TableView>
            <Button fx:id="backBtn" mnemonicParsing="false" onAction="#goBack" text="Back" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
