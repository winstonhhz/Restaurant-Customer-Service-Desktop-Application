<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="451.0" prefWidth="454.0" spacing="10.0" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.restaurantcustomerservice.controller.AdminViewController">
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Admin Menu Manager" />
    <ComboBox fx:id="categoryBox" promptText="Select Category" />
    <TextField fx:id="itemField" promptText="Enter Item Name" />
    <TextField fx:id="priceField" promptText="Enter Price" />
    <Button fx:id="importImageButton" text="Import Image" />
    <Label fx:id="imageStatusLabel" text="No image selected" />
    <HBox alignment="CENTER" fillHeight="false" prefHeight="25.0" prefWidth="453.0" spacing="10.0">
        <Button fx:id="addButton" text="Add" />
        <Button fx:id="updateButton" text="Update" />
        <Button fx:id="deleteButton" text="Delete" />
    </HBox>
    <Button fx:id="viewMenuButton" prefWidth="103.0" text="View Menu" />
    <Label fx:id="statusLabel" />
    <Button onAction="#handleBack" text="Back" />
</VBox>
