<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="270.0" prefWidth="316.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurantcustomerservice.controller.ReservationMainController">
    <children>
      <VBox alignment="CENTER" layoutX="46.0" layoutY="35.0" prefHeight="200.0" prefWidth="224.0" spacing="30.0">
         <children>
              <Button fx:id="customerBtn" onAction="#goToCustomer" text="Customer" />
              <Button onAction="#goToCheckStatus" prefHeight="25.0" prefWidth="219.0" text="Check My Reservation Status" />
            <Button onAction="#handleBack" text="Back" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
    </children>
</AnchorPane>
